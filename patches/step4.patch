diff --git a/app/tests/i18n-credit.ts b/app/tests/i18n-credit.ts
new file mode 100644
index 0000000..1a9322b
--- /dev/null
+++ b/app/tests/i18n-credit.ts
@@ -0,0 +1,24 @@
+/**
+ * test:credit — the credit contract on every page.
+ * - "by Elghaly LLC" linked to https://elghaly.dev sits under the page title (Header).
+ * - "Wyndham Heaven" (Latin, untranslated) is the last line of the footer.
+ * - Neither depends on the active locale.
+ */
+import { readFileSync } from "node:fs";
+
+let fail = 0;
+const check = (ok: boolean, msg: string) => { if (!ok) { fail++; console.log("  FAIL | " + msg); } };
+
+const header = readFileSync(new URL("../src/components/Header.tsx", import.meta.url), "utf8");
+const app = readFileSync(new URL("../src/App.tsx", import.meta.url), "utf8");
+
+check(/by\s*<a\s+href="https:\/\/elghaly\.dev"[^>]*>Elghaly LLC<\/a>/.test(header), "header: by Elghaly LLC linked to https://elghaly.dev");
+check(/<\/h1>[\s\S]{0,400}Elghaly LLC/.test(header), "header: credit sits under the <h1>");
+check(/Wyndham Heaven/.test(app), "footer: Wyndham Heaven present");
+check(/Wyndham Heaven<\/p>\s*<\/footer>/.test(app), "footer: Wyndham Heaven is the last line inside <footer>");
+check(!/Wyndham Heaven/.test(header), "header: Wyndham Heaven must not appear there");
+check(!/by:\s*"Wyndham Heaven"/.test(readFileSync(new URL("../../agent/thoth-page.js", import.meta.url), "utf8")), "manifest by: must not carry Wyndham Heaven");
+check(!/\bfree\b/i.test(header) && !/\bfree\b/i.test(app), "no 'free' in header or footer");
+
+console.log(fail ? `i18n-credit: FAIL (${fail})` : "i18n-credit: PASS 7/7");
+process.exit(fail ? 1 : 0);
