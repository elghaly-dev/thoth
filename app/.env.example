# GEMINI_API_KEY: required for the server to answer model requests.
# The key is injected from the environment / secrets panel at runtime.
# Never commit a real key. Leave the value empty here.
GEMINI_API_KEY=

# APP_URL: the URL where this app is hosted (optional).
APP_URL=

# PORT: the port the server listens on (optional, default 3000).
PORT=
