{
  "name": "thoth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:smoke": "tsx tests/smoke-locales.ts",
    "test:zh": "tsx tests/zh-parity.ts",
    "test:nofree": "tsx tests/no-free-wording.ts",
    "test:server": "tsx tests/server-hardening.ts",
    "test:auth": "tsx tests/server-auth.ts",
    "test:locales": "tsx tests/locale-parity.ts",
    "test:langpref": "tsx tests/lang-pref.ts",
    "test:mic": "tsx tests/mic-blocked.ts",
    "build:pages": "THOTH_BASE=/use/ vite build --outDir ../use --emptyOutDir",
    "test": "tsx tests/smoke-locales.ts && tsx tests/idle-session.ts && tsx tests/no-secrets.ts && tsx tests/pages-redirect.ts",
    "test:idle": "tsx tests/idle-session.ts",
    "test:secrets": "tsx tests/no-secrets.ts",
    "test:pages": "tsx tests/pages-redirect.ts",
    "test:site": "tsx tests/site-wording.ts",
    "test:ondevice": "tsx tests/ondevice.ts",
    "test:network": "tsx tests/network.ts",
    "test:live-model": "tsx tests/live-model.ts",
    "licences": "node scripts/gen-licences.mjs",
    "test:licences": "node scripts/gen-licences.mjs --check",
    "test:a11y": "tsx tests/a11y-labels.ts",
    "test:byok": "node ../tools/check-byok-storage.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@google/genai": "^3.2.0",
    "@mlc-ai/web-llm": "0.2.87",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
